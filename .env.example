# Copy this file to .env and fill in the values. .env is git-ignored.
# This file is meant to be committed, so keep real keys OUT of it.

# ─── Neon Postgres ──────────────────────────────────────────────
# Neon Console → project → Connect → pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# ─── Neon AI Gateway (all LLM + embedding calls) ────────────────
# Bare host, no path: https://<branch-id>-api.ai.<region>.aws.neon.tech
NEON_AI_GATEWAY_BASE_URL=
# Starts with nt_live_
NEON_AI_GATEWAY_TOKEN=

# Model IDs as the gateway names them (checked against /v1/models).
STRONG_MODEL=claude-opus-5-5
CHEAP_MODEL=claude-haiku-5-5
FALLBACK_MODEL=claude-sonnet-5-5
EMBEDDING_MODEL=qwen3-embedding-0-6b
EMBEDDING_DIMENSIONS=1024

# ─── SubQ (decision + long-context model) ───────────────────────
SUBQ_API_KEY=
SUBQ_BASE_URL=https://api.subq.ai/v1
# Decision model: POST /systemone, returns labels with probabilities. 384K context.
SUBQ_DECISION_MODEL=subq-snap-1.2
# Long-context chat model: OpenAI-compatible /chat/completions, 4M context.
SUBQ_LONG_CONTEXT_MODEL=subq-savant-1.4
# Prices in USD per 1M tokens (docs.subq.ai), used by the benchmark cost math.
SUBQ_SNAP_INPUT_PER_MTOK=0.04
SUBQ_SAVANT_INPUT_PER_MTOK=0.10
SUBQ_SAVANT_OUTPUT_PER_MTOK=0.50

# ─── App ────────────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000

# Optional: password-protect the console when hosted (any username)
CONSOLE_PASSWORD=
